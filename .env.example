# ─── Revenue Pipeline ───────────────────────────────────────────────────────
# Stripe: create a Product "Security Report — Starter" at $297 CAD, then:
STRIPE_SECRET_KEY=sk_live_...
STRIPE_STARTER_PRICE_ID=price_...
# Or use a pre-built Payment Link URL as a fallback:
STRIPE_STARTER_PAYMENT_LINK=https://buy.stripe.com/...
STRIPE_SUCCESS_URL=https://bugreaper.io/report/delivered
STRIPE_CANCEL_URL=https://bugreaper.io/report/cancelled

# SMTP (Gmail: use an App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASS=your_app_password
FROM_NAME=Ryan — Bug Reaper Security
FROM_EMAIL=you@yourdomain.com

# Pipeline tuning
PIPELINE_BATCH_SIZE=50
PIPELINE_LOOP_SECS=0
