# Bug Reaper - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ─── Google Gemini API ──────────────────────────────────────────────────────
# Required for AI-enhanced analysis (vulnerability summaries, code generation)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/bugreaper

# ─── Redis / Message Queue ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Notification Integrations (optional) ───────────────────────────────────
SLACK_WEBHOOK_URL=
PAGERDUTY_API_KEY=
JIRA_API_TOKEN=
JIRA_BASE_URL=
DISCORD_WEBHOOK_URL=

# ─── GitHub Integration (optional) ──────────────────────────────────────────
GITHUB_TOKEN=

# ─── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=https://occgwktryhynxonuyixm.supabase.co
