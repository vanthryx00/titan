# Bug Reaper - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ─── Google Gemini API ──────────────────────────────────────────────────────
# Required for AI-enhanced analysis (vulnerability summaries, code generation)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/bugreaper

# ─── Redis / Message Queue ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Notification Integrations (optional) ───────────────────────────────────
SLACK_WEBHOOK_URL=
PAGERDUTY_API_KEY=
JIRA_API_TOKEN=
JIRA_BASE_URL=
DISCORD_WEBHOOK_URL=

# ─── GitHub Integration (optional) ──────────────────────────────────────────
GITHUB_TOKEN=

# ─── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=https://occgwktryhynxonuyixm.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9jY2d3a3RyeWh5bnhvbnV5aXhtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzU0OTQxOTEsImV4cCI6MjA5MTA3MDE5MX0.vm7TaTYKYLNZvDMzgFKUCNBYqVYZ-B5Giayf6V3IuEE
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ZwRk_61mLMEHy-Z5TE99rA_38bANHxa

# ─── Application Settings ───────────────────────────────────────────────────
APP_ENV=development
